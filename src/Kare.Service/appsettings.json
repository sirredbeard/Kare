{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Loopback": {
        "Url": "http://127.0.0.1:5285"
      }
    }
  },
  "Kare": {
    "Service": {
      "ModelId": "kare-local",
      "AllowNonLoopbackBinding": false
    },
    "Inference": {
      "Limits": {
        "MaxPromptTokens": 3072,
        "MaxOutputTokens": 1024,
        "MaxConcurrentInference": 1,
        "MaxQueueDepth": 8
      },
      "OnnxGenAi": {
        "ModelPath": "",
        "ModelId": "phi-4-mini-instruct-int4",
        "Priority": 0
      }
    }
  }
}
